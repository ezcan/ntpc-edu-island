{
  "name": "ntpc-education-island",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run validate:data && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "import:schedules": "tsx scripts/import-schedules.ts"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  }
}
